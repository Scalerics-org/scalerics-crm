# Copiar a .env y completar. El .env no va al repo (esta en .gitignore).
# Para levantar el CRM en local alcanza con el primer bloque.

# ── Minimo para arrancar ──────────────────────────────────────────────────────
# Firma de la sesion de Flask. En local cualquier string largo sirve;
# en produccion tiene que ser un valor secreto y estable.
SECRET_KEY=
# Ruta de la base SQLite. Por defecto leads.db en la raiz del proyecto.
DB_PATH=
# Codigo de invitacion para /register. Sin este valor el registro queda CERRADO:
# el endpoint esta exento del login, asi que sin codigo cualquiera se crea cuenta.
REGISTER_CODE=

# ── Datos de la agencia (salen en mails y presupuestos) ───────────────────────
FACTORY_NAME=Scalerics
FACTORY_EMAIL=hola.scalerics@gmail.com
FACTORY_PHONE=+598 XX XXX XXX
FACTORY_WEBSITE=
# Mail que recibe los avisos de usuario nuevo.
ADMIN_EMAIL=
# URL publica del CRM, para los links de los mails.
CRM_URL=

# ── Envio de mails (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── IA: generacion de demos y presupuestos (Anthropic) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Deploy de demos a Vercel ─────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_NAME=scalerics-demos

# ── Google Calendar (OAuth) ──────────────────────────────────────────────────
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
# Lo escriben solos setup_calendar.py / setup_gmail.py; sirve para el aviso de
# vencimiento en el panel de tokens.
GCAL_TOKEN_RENEWED_AT=
GMAIL_TOKEN_RENEWED_AT=

# ── Gmail (OAuth, para setup_gmail.py) ───────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Calendly ─────────────────────────────────────────────────────────────────
# Secreto para validar la firma del webhook.
CALENDLY_WEBHOOK_SECRET=
# Mails que no generan lead al agendar (separados por coma).
CALENDLY_BLOCKED_EMAILS=tumail@gmail.com,otrointerno@gmail.com

# ── Meta Lead Ads (webhook + import de leads) ────────────────────────────────
# App de Meta (developers.facebook.com). El APP_SECRET firma el webhook: sin el,
# todo POST a /api/meta/webhook se rechaza con 403.
META_APP_ID=
META_APP_SECRET=
# Pagina de Facebook de la que salen los formularios.
META_PAGE_ID=
# Page Token de larga duracion, con leads_retrieval y pages_read_engagement.
# En produccion se renueva con:
#   flyctl secrets set META_PAGE_TOKEN=<nuevo> -a scalerics-crm
META_PAGE_TOKEN=
# El string que Meta manda en hub.verify_token al dar de alta el webhook.
META_VERIFY_TOKEN=
# Solo para desarrollo local: acepta webhooks sin firma cuando no hay
# META_APP_SECRET. En produccion tiene que quedar vacio.
META_ALLOW_UNSIGNED=
# Valvula de prueba: si tiene una direccion, los avisos de lead de Meta van
# SOLO ahi en vez de a todos los admins. Sirve para probar la integracion sin
# escribirle al equipo. En produccion tiene que quedar vacia.
META_NOTIFY_OVERRIDE=
# Apaga los recordatorios por mail a los leads de Meta sin tocar el deploy.
# Cualquier valor distinto de "off" los deja andando.
META_RECORDATORIOS=

# ── Bot de WhatsApp (servicio aparte, en bot/) ───────────────────────────────
BOT_API_URL=
WA_ACCESS_TOKEN=
# Telefono que recibe el aviso de lead nuevo por WhatsApp. Vacio = solo mail.
ADMIN_WA_PHONE=

# ── Transcripcion de reuniones (Recall) ──────────────────────────────────────
RECALL_API_KEY=

# ── Acceso server-to-server a /api/ ──────────────────────────────────────────
# Cualquier request a /api/ con este valor en el header x-admin-token saltea la
# sesion. Tratarlo como una credencial de admin.
ADMIN_TOKEN=
