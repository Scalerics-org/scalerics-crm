# Sin esto, en Windows core.autocrlf=true deja los scripts con \r\n en el disco.
# Docker copia el disco, y en Linux el kernel lee el shebang "#!/bin/sh\r" y
# busca un interprete llamado "/bin/sh\r" que no existe. El error que tira es
# "No such file or directory" sobre el script — que esta ahi — asi que manda a
# buscar el problema al lugar equivocado.
#
# Tumbo el CRM dos veces antes de encontrarlo.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.service       text eol=lf
*.timer         text eol=lf

*.db    binary
*.png   binary
*.jpg   binary
*.pdf   binary
