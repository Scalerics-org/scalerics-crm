# Copiar a /etc/default/scalerics-backup y completar. chmod 600.

DESTINO=/var/backups/scalerics
RETENER_DIAS=30
APP_DIR=/opt/scalerics-wa

# App del CRM en Fly. Vacio = solo respalda el bot.
FLY_APP=scalerics-crm
# Token para que flyctl corra sin sesion interactiva. Se saca en la laptop con:
#   fly tokens create readonly --name backup-servidor
# Es de solo lectura: sirve para leer el volumen, no para deployar ni borrar.
FLY_API_TOKEN=

# Telefono del AM. Si el backup falla, avisa por el mismo WhatsApp del bot.
AVISAR_A=59894053389
