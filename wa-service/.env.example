# Copiar a .env y completar. El .env no va al repo.

# ── servicio ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
# Clave que el CRM manda en el header x-api-key. Generar con: openssl rand -hex 32
WA_API_KEY=

# ── proveedor ─────────────────────────────────────────────────────────────────
# mock = no envia nada, loguea y persiste. Sirve para dev y tests, sin numero.
# baileys = cliente no oficial de WhatsApp (Fase 3, necesita el numero secundario).
WA_PROVIDER=mock
DB_PATH=./data/scalerics-wa.db

# ── baileys ───────────────────────────────────────────────────────────────────
# Credenciales de sesion. NUNCA al repo, y hay que respaldarlo: si se pierde
# hay que re-escanear el QR, y re-vincular seguido es senial sospechosa.
BAILEYS_AUTH_DIR=./auth
# Nombre que muestra el telefono en "Dispositivos vinculados". Se manda AL VINCULAR:
# cambiarlo despues no renombra una sesion activa, hay que desvincular y re-escanear.
# Un nombre propio es mas facil de reconocer; uno de navegador se confunde menos.
BAILEYS_DEVICE_NAME=Chrome

# ── panel WA del CRM ──────────────────────────────────────────────────────────
# El CRM pega a /api/* con el header x-admin-token. Tiene que ser el MISMO valor
# que el ADMIN_TOKEN del CRM. Para reemplazar al bot viejo, apuntar su
# BOT_API_URL a este servicio.
ADMIN_TOKEN=
# Para avisarle al CRM cuando un lead califica o pide un humano. Vacio = no avisa.
CRM_API_URL=
CRM_ADMIN_TOKEN=

# ── embudo de calificacion ────────────────────────────────────────────────────
FUNNEL_ENABLED=true
CALENDLY_LINK=https://calendly.com/scalerics/diagnostico
# Una sola clave para las tres cosas: conversacion, scoring y transcripcion de
# audios. Sin ella el bot funciona igual, con el embudo de preguntas fijas y el
# scoring por reglas, y a los audios les pide que los escriban. Se saca en
# platform.openai.com.
OPENAI_API_KEY=

# La conversacion la lleva el modelo en vez del embudo de preguntas numeradas.
# Solo tiene efecto si hay OPENAI_API_KEY. Para volver al embudo fijo sin perder
# el scoring con IA, poner false.
IA_CONVERSACION=true
# gpt-4o-mini alcanza y sale una fraccion de los grandes. Si las respuestas
# quedan cortas de calidad, se cambia el modelo aca.
IA_MODELO=gpt-4o-mini

# Notas de voz a texto. Las de WhatsApp vienen en OGG/Opus y la API las acepta
# tal cual, sin convertir nada.
IA_TRANSCRIPCION=true
IA_MODELO_AUDIO=whisper-1
# Mas largo que esto no se transcribe: es plata y ademas conviene que lo escuche
# una persona.
MAX_AUDIO_SEGUNDOS=300

# Cada cuantos minutos, como mucho, se le pide a alguien que escriba en vez de
# mandar audios.
AVISO_SIN_TEXTO_MINUTOS=30

# Lo que se le dice al lead cuando queda esperando a una persona. Es distinto de
# BUSINESS_HOURS: ese rango es cuando el bot puede mandar, este es cuando hay
# alguien del otro lado.
HORARIO_ATENCION=Lun a sáb, 9 a 19hs

# ── negocio ───────────────────────────────────────────────────────────────────
# Telefonos de los account managers, coma-separados, E.164 sin '+'.
AM_PHONES=59899000111
DEFAULT_COUNTRY_CODE=598
TZ=America/Montevideo

# ── follow-up ─────────────────────────────────────────────────────────────────
# Solo sale si el lead NO agendo en Calendly.
FOLLOWUP_DELAY_HOURS=72
# Jitter en minutos para que no salgan todos los follow-ups a la misma hora.
FOLLOWUP_JITTER_MINUTES=90

# ── recordatorios de reunion agendada ─────────────────────────────────────────
# El del dia antes solo se programa si al agendar falta mas de ese plazo.
REMINDER_DAY_BEFORE_HOURS=24
REMINDER_MINUTES_BEFORE=30

# ── ritmo de envio ────────────────────────────────────────────────────────────
# La ficha al AM es interna: sale casi sin demora.
DELAY_AM_MIN_MS=1000
DELAY_AM_MAX_MS=3000
# La bienvenida al lead espera un poco: llegar 0ms despues del submit se nota.
DELAY_WELCOME_MIN_MS=8000
DELAY_WELCOME_MAX_MS=25000
# Entre dos mensajes cualesquiera de la cola.
DELAY_BETWEEN_MIN_MS=12000
DELAY_BETWEEN_MAX_MS=45000
# "escribiendo..." antes de cada mensaje. Apagarlo solo en tests.
TYPING_ENABLED=true

# ── anti-baneo ────────────────────────────────────────────────────────────────
# Si se pasa de estos limites el mensaje NO se descarta: se reprograma.
MAX_MSGS_PER_HOUR=30
# El que mas pesa: primer mensaje a un numero que nunca escribio.
MAX_NEW_CONTACTS_PER_HOUR=12
MAX_MSGS_PER_DAY=200

# Fecha de alta del numero secundario (YYYY-MM-DD). Activa la rampa: 5 contactos
# nuevos por dia la primera semana, 15 hasta el dia 7, 40 hasta el 14, despues
# el limite normal. Vacio = sin rampa (solo para un numero ya rodado).
WARMUP_START_DATE=

# Los mensajes al LEAD fuera de este horario se reprograman para la proxima
# apertura. Los avisos al AM salen siempre: son contacto interno.
BUSINESS_HOURS=09:00-19:00
BUSINESS_DAYS=mon-sat

# Si hay N fallos de envio en la ventana, se pausa la cola y se avisa al AM.
CIRCUIT_BREAKER_FAILS=3
CIRCUIT_BREAKER_WINDOW_MIN=10
CIRCUIT_BREAKER_PAUSE_MIN=30
