# El Dockerfile hace `COPY . .`, asi que sin este archivo la imagen se lleva
# secretos y datos productivos horneados en cada capa.

.env
.env.*
!.env.example
credentials.json
ll_token.txt
pages.json

# Bases de datos: nunca dentro de la imagen. La base vive en el volumen (/data).
*.db
*.db-wal
*.db-shm
prod_snapshot*.db
prod_limpia.db
backups/

